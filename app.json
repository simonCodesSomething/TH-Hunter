{
  "expo": {
    "name": "Hot Wheels Hunter",
    "slug": "hotwheels-hunter",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/ios-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.hotwheelshunter"
    },
    "android": {
      "package": "com.yourcompany.hotwheelshunter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "backgroundColor": "#000000"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/ios-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    
    "extra": {
      "eas": {
        "projectId": "a29e0632-cfa3-41b0-abb3-d831025901c3"
      }
    }
  }
}
