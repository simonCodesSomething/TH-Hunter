
{
  "expo": {
    "name": "TH Hunter",
    "slug": "th-hunter",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simonreact.thhunter"
    },
    "android": {
      "package": "com.simonreact.thhunter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "backgroundColor": "#000000"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
[
  "expo-splash-screen",
  {
    "backgroundColor": "#000000",
    "image": "./assets/splash-icon.png",
    "imageWidth": 200,
    "resizeMode": "contain",
    "android": {
      "backgroundColor": "#000000",
      "image": "./assets/splash-icon.png",
      "imageWidth": 200
    }
  }
],
      "expo-status-bar",
      "expo-asset",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5794787274519836~1315926917"
        }
      ]
    ],
    "extra": {
